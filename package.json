{
  "name": "capture-page",
  "version": "0.3.0",
  "type": "module",
  "funding": "https://github.com/sponsors/Jaid",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jaid/capture-page.git"
  },
  "imports": {
    "#src/*": "./src/*",
    "#root/*": "./*"
  },
  "scripts": {
    "build": "build_lib --terser-strength aggressive",
    "lint": "tsc --noEmit --noUnusedLocals --pretty false",
    "test": "bun test --max-concurrency 1 ./test",
    "test_live": "CAPTURE_PAGE_LIVE=1 bun test --max-concurrency 1 ./test"
  },
  "dependencies": {
    "fs-extra": "11.4.1",
    "puppeteer-core": "25.15.0"
  },
  "optionalDependencies": {
    "sass": "1.106.0"
  },
  "devDependencies": {
    "eslint": "10.13.0",
    "eslint-config-jaid": "37.1.0",
    "tsconfig-jaid-bun": "16.0.0",
    "typescript": "npm:typescript-classic@6.0.4",
    "@types/bun": "1.4.3",
    "@types/fs-extra": "11.0.4"
  }
}